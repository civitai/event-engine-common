{
  "name": "@civitai/event-engine-common",
  "version": "1.0.0",
  "description": "Common services and utilities for Civitai event engine applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run lint && npm run build",
    "test": "echo \"No tests specified\" && exit 0",
    "lint": "eslint **/*.ts",
    "lint:fix": "eslint **/*.ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "civitai",
    "event-engine",
    "metrics",
    "outbox-pattern",
    "typescript",
    "services"
  ],
  "author": "Civitai",
  "license": "MIT",
  "dependencies": {
    "meilisearch": "^0.35.0"
  },
  "peerDependencies": {
    "redis": "^4.7.0",
    "pg": ">=8.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist/",
    "README.md"
  ]
}
